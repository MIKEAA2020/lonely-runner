## 6. Scanner **v2** — replaces the previous version

Two independent detectors: a dictionary of *all* `\n`-initial control words, plus a dictionary-free structural check (any non-`\`, non-comment text at bracket/brace depth 0 in the preamble is damage).

```python
# fix_newline_damage.py v2 — usage: python fix_newline_damage.py . [--fix]
import re, sys, pathlib, shutil

ROOT, FIX = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else "."), "--fix" in sys.argv

N_COMMANDS = """nabla natural ne nearrow neg neq newcommand newenvironment newline newpage
newtheorem newcounter newlength newsavebox newfont nexists ni nleftarrow not notin nu
numberwithin nparallel nrightarrow nsubseteq nsupseteq nwarrow noindent nonumber nolimits
normalfont normalsize notag newcolumntype newlabel ncong nleq ngeq nless ngtr nmid nsim
nsubseteqq nsupseteqq ntriangleleft ntriangleright nVDash nVdash nvDash nvdash newbox newif
newtoks newmuskip newdimen newskip nRightarrow nleftrightarrow nLeftrightarrow nLeftarrow
nprec nsucc npreceq nsucceq newwrite newread""".split()
FRAGS = sorted({c[1:] for c in N_COMMANDS}, key=len, reverse=True)
PAT   = re.compile(r"(?m)^(" + "|".join(map(re.escape, FRAGS)) + r")(?![A-Za-z])")
AMBIG = {"e", "u", "i", "eq", "eg"}          # report only; never auto-rewrite

def structural(src):                          # dictionary-free preamble check
    pre, depth, out = src.split("\\begin{document}")[0], 0, []
    for i, ln in enumerate(pre.split("\n"), 1):
        t = re.sub(r"(?<!\\)%.*", "", ln).strip()
        if depth == 0 and t and not t.startswith("\\"):
            out.append((i, t[:60]))
        b = t.replace(r"\{","").replace(r"\}","").replace(r"\[","").replace(r"\]","")
        depth += b.count("{") + b.count("[") - b.count("}") - b.count("]")
    return out

total = 0
for f in sorted(ROOT.rglob("*.tex")):
    txt  = f.read_text(encoding="utf-8")
    hits = [(txt[:m.start()].count("\n")+1, m.group(1)) for m in PAT.finditer(txt)]
    extra = [x for x in structural(txt) if x[0] not in {i for i, _ in hits}]
    if not hits and not extra:
        continue
    total += len(hits) + len(extra)
    print(f"\n[{f}]")
    for ln, frag in hits:
        print(f"  L{ln:>4}: {frag}...  -> \\n{frag}...  [{'REVIEW' if frag in AMBIG else 'AUTO'}]")
    for ln, t in extra:
        print(f"  L{ln:>4}: UNRECOGNISED PREAMBLE TEXT: {t}  [REVIEW]")
    if FIX:
        shutil.copy2(f, f.with_suffix(".tex.bak"))
        f.write_text(PAT.sub(lambda m: m.group(0) if m.group(1) in AMBIG else "\\n"+m.group(1), txt),
                     encoding="utf-8")
print(f"\n{total} findings; {'fixed (backups .tex.bak)' if FIX else 'dry-run, nothing written'}")
```

**Why this matters beyond compile errors:** in the *body*, `\n`-damage is often **silent**. `\neq` → a line break plus the literal text `eq`; `\nu` → `u`; `\notin` → `otin`; `\nabla` → `abla`; `\nonumber` → `onumber` *and the equation silently gets a number*. No error, no warning — just wrong mathematics in the PDF. Proofreading the output is not a substitute for running this scan over all 16 sources.

